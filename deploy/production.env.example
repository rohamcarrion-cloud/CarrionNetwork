# Compose interpolation only. Copy outside Git as config/production.env (0600).
# Build and push both custom images for linux/amd64; record provenance and digest.
API_IMAGE=registry.example.invalid/carrion-api@sha256:REPLACE_WITH_DIGEST
PROXY_IMAGE=registry.example.invalid/carrion-proxy@sha256:REPLACE_WITH_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_REVIEWED_POSTGRES_17_DIGEST
SITE_DOMAIN=podcasts.example.invalid
ACME_EMAIL=owner@example.invalid
