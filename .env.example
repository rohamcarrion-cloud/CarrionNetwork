DATABASE_URL=postgres://carrion:carrion_local_only@localhost:5434/carrion_network
PORT=3010
# Canonical API delivery base, including proxy prefix when applicable.
# Use HTTPS outside loopback development; never derive RSS URLs from request Host.
PUBLIC_BASE_URL=http://localhost:3010
WEB_ORIGIN=http://localhost:5173

# Private filesystem media storage (back up alongside PostgreSQL)
MEDIA_STORAGE_DIR=./var/media

# Maximum MP3 upload bytes (default 100 MiB); images retain their 10 MiB limit.
AUDIO_MAX_UPLOAD_BYTES=104857600
